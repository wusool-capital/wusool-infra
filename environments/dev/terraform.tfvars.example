key_name         = "wusool-dev-frankfurt"
# SSM is the default administration path; leave empty to disable public SSH.
ssh_cidr_blocks  = []
instance_type    = "t3.small"
ami_architecture = "x86_64"

# HTTPS is verified; n8n must not be exposed directly.
expose_n8n_port = false

alert_email = "your-email@example.com"
