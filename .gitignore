# --- Terraform ---
# Local .terraform directories (providers, modules cache)
**/.terraform/*
.terraform.lock.hcl.bak

# State files — never commit; they live in the S3 remote backend
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Plan output files
*.tfplan
tfplan
tfplan[0-9]*
*.tfplan.*

# Secret variable files — values containing credentials/secrets.
# Non-secret terraform.tfvars (committed per-env) are force-included below.
*.tfvars
*.auto.tfvars
*.tfvars.json
!*.tfvars.example
# Per-environment NON-SECRET config, deliberately committed so that changing it
# is reviewable in a PR plan. Secrets stay in Secrets Manager.
!terraform/envs/*.tfvars

# Terraform CLI config & override files
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Claude Code ---
# Personal, machine-local overrides — do NOT share.
# .claude/settings.json IS committed (shared team config).
.claude/settings.local.json

# --- Secrets / credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*_rsa
*_rsa.pub
.aws/

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local archived workspace files
_archive/

# Generated migration/discovery outputs
outputs/
