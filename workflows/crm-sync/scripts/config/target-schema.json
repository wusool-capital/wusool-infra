    {
      "name": "Notes",
      "status": "proposed_not_yet_implemented",
      "attio_kind": "object",
      "attio_slug": "notes",
      "attio_object_status": "needs_creation",
      "postgres_table": "notes",
      "purpose": "Single unified notes table replacing the separate notes fields scattered across Organization, Person, Buyer Role, and Seller Role.",
      "ownership_direction": "Mastered in PostgreSQL (backfilled from Attio once, then written by the meeting-summary pipeline going forward); pushed one-way to Attio purely so the team can see it there. Attio is a mirrored view, not the source of truth, for this table.",
      "fields": [
        {"slug": "id", "type": "uuid", "ownership": "key"},
        {"slug": "organization_id", "type": "record-reference", "ownership": "key", "target": "Organization", "purpose": "Always set - directly for org-level notes, or derived via the person's/role's parent org otherwise."},
        {"slug": "person_id", "type": "record-reference", "ownership": "key", "target": "Person", "nullable": true, "purpose": "Set only when the note is about a specific person, not the organization generally."},
        {"slug": "buyer_role_id", "type": "record-reference", "ownership": "key", "target": "BuyerRole", "nullable": true, "purpose": "Set when the organization/person is on the buy side."},
        {"slug": "seller_role_id", "type": "record-reference", "ownership": "key", "target": "SellerRole", "nullable": true, "purpose": "Set when the organization/person is on the sell side."},
        {"slug": "note_type", "type": "enum", "ownership": "both", "options": ["Manual", "Meeting"], "purpose": "Manual = historical/hand-entered note; Meeting = generated from a meeting transcript summary."},
        {"slug": "content", "type": "text", "ownership": "both"},
        {"slug": "created_at", "type": "timestamp", "ownership": "both"}
      ],
      "population": {
        "historical_backfill": "One row per existing note on Organization.notes, Person.notes, and Buyer Role notes/additional_notes, all as note_type=Manual. organization_id is set directly for org-level notes; for person-level notes, organization_id is derived via the person's company. buyer_role_id/seller_role_id are set when that organization has an active Buyer Role / Seller Role entry.",
        "ongoing": "After each meeting, a transcript summary is generated and inserted as a new row with note_type=Meeting, linked to whichever person/organization/buyer_role/seller_role the meeting was about."
      },
      "open_questions": [
        "Attio object 'notes' does not exist yet in DEV - needs to be created before this can sync there.",
        "Whether historical Buyer Role notes/additional_notes and any Seller Role notes should be copied into this table or left in place once Notes exists (duplication risk if both are kept live)."
      ]
    },
    {
      "name": "Activities",
      "status": "proposed_not_yet_implemented",
      "postgres_table": "activities",
      "postgres_only": true,
      "purpose": "Append-only touch/interaction log. Replaces the scattered first/last/next_*_interaction summary fields on Organization and Person, plus Mandate.outreach_started_date, with real per-event rows - those become computed queries (MIN/MAX(occurred_at)) against this table instead of separately-maintained columns.",
      "fields": [
        {"slug": "id", "type": "uuid", "ownership": "postgres"},
        {"slug": "subject_type", "type": "enum", "ownership": "postgres", "options": ["Organization", "Person", "BuyerRole", "SellerRole", "Mandate", "Deal"], "purpose": "Discriminator for the polymorphic subject_id reference below."},
        {"slug": "subject_id", "type": "uuid", "ownership": "postgres", "purpose": "References whichever table subject_type names. Whether an org/person is on the buy or sell side is captured by pointing subject_id at their BuyerRole or SellerRole entry, not by a separate flag."},
        {"slug": "actor_id", "type": "record-reference", "ownership": "postgres", "target": "User", "nullable": true, "purpose": "Null for system-generated activities (e.g. data room created) with no human actor."},
        {"slug": "occurred_at", "type": "timestamptz", "ownership": "postgres"},
        {"slug": "channel", "type": "enum", "ownership": "postgres", "options": ["Calendar", "Email", "Call", "Outreach", "DataRoom", "Nudge", "Other"], "options_status": "needs_approval", "purpose": "Calendar/Email/Other map to SOURCE's existing interaction tracking; Outreach/DataRoom/Nudge are net-new, not backfilled from SOURCE."},
        {"slug": "direction", "type": "enum", "ownership": "postgres", "options": ["In", "Out"], "nullable": true, "purpose": "Null for non-directional system events (e.g. data room created)."},
        {"slug": "outcome", "type": "text", "ownership": "postgres", "nullable": true},
        {"slug": "source", "type": "text", "ownership": "postgres", "purpose": "Citation of where this row came from, e.g. 'SOURCE Attio first_email_interaction backfill' or 'DEV data room service'."}
      ],
      "population": {
        "historical_backfill": "One row per available boundary timestamp from Organization/Person first_calendar_interaction (channel=Calendar), last_calendar_interaction (channel=Calendar), next_calendar_interaction (channel=Calendar), first_email_interaction/last_email_interaction (channel=Email), first_interaction/next_interaction (channel=Other), and Mandate.outreach_started_date (channel=Outreach, direction=Out). These are only the boundary points SOURCE happened to track, not a full history - the backfill can't reconstruct touches SOURCE never recorded.",
        "ongoing": "Every real touch going forward (email sent/received, call, meeting, data room created, nudge sent) is inserted as its own row at the moment it happens. Organization/Person last_interaction_at keeps being written directly for now (unchanged) but should eventually be derivable as MAX(occurred_at) from this table instead."
      },
      "left_out_on_purpose": [
        "strongest_connection_strength_legacy - a legacy categorical value, not a timestamped touch",
        "associated_deals / associated_people - relationship lists, not activities",
        "nddl_last_duplicate_check - internal dedup-check metadata, not a customer-facing touch",
        "notes/additional_notes - covered by the separate proposed Notes table, not this log"
