# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (existing wusool_crm database; through the SSM tunnel in dev).
# Either postgresql:// or postgresql+asyncpg:// is accepted; the driver
# scheme is normalized automatically.
DATABASE_URL=postgresql://user:password@localhost:15432/wusool_crm

# Slack — this bot shares one Slack app/token with matching-engine (see
# ../README.md and ../../../SLACK_APP_SETUP.md); only used here for running
# this folder's own tests/standalone app in isolation, not for the deployed bot.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Optional: Slack incoming webhook the Attio sync guard posts to when it
# skips a bot-managed row. Leave unset locally — the sync script falls back
# to printing a warning instead.
SYNC_ALERT_WEBHOOK_URL=
