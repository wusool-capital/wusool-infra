# Application
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Database (existing wusool_crm database; through the SSM tunnel in dev).
# Either postgresql:// or postgresql+asyncpg:// is accepted; the driver
# scheme is normalized automatically. Shared by both matching-engine and
# ddl-commands — they connect to the same wusool_crm database independently.
DATABASE_URL=postgresql://user:password@localhost:15432/wusool_crm

# Slack — one bot, one app, one token for all 5 commands (/find-match,
# /edit-seller, /edit-buyer, /add-seller, /add-buyer). See SLACK_APP_SETUP.md
# at the repo root.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# DEV Attio workspace write access — same value as crm-sync's DEV_ATTIO_API_KEY,
# confirmed write-capable in DEV. /edit-*/add-* write to Attio first, then
# Postgres, in the same request (see ddl-commands/README.md).
ATTIO_API_KEY=

# Signs inbound Attio webhook deliveries (POST /webhooks/attio) — returned
# once by Attio in the response to POST /v2/webhooks, never retrievable
# again after that.
ATTIO_WEBHOOK_SECRET=

# The "deals" native object's api_slug differs by workspace: DEV Attio calls
# it "deals" (plural); SOURCE Attio's custom object is "deal" (singular).
# Defaults to DEV's shape.
ATTIO_DEAL_OBJECT_SLUG=deals

# The unified "note" object exists only in SOURCE Attio today. Leave unset
# in dev (skips note sync); prod sets this to "note".
ATTIO_NOTE_OBJECT_SLUG=

# --- matching-engine only, below ---

# AWS Bedrock (region/model IDs match what's already provisioned in
# terraform/environments/dev's bedrock-access module; access key/secret are optional —
# omit them to use the standard AWS credential provider chain)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID_EXTRACTION=eu.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_BEDROCK_MODEL_ID_REASONING=eu.anthropic.claude-sonnet-4-6

# Bedrock inference parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TOP_P=0.9

# Matching pipeline
STAGE3_TOP_N=3

# Scoring configuration (weights should sum to 1.0)
SCORING_WEIGHT_STRATEGY=0.4
SCORING_WEIGHT_SIZE=0.3
SCORING_WEIGHT_SECTOR=0.3

# Confidence multipliers
CONFIDENCE_LLM_EXTRACTED=0.6
CONFIDENCE_LLM_INFERRED=0.4
CONFIDENCE_MISSING_FIELD_PENALTY=0.1
CONFIDENCE_STALE_DATA_PENALTY=0.15

FIRECRAWL_API_KEY=
WEB_FALLBACK_MIN_SCORE=50.0

# Meeting-notes enrichment (buyer side always on; seller side on by default,
# set ENABLE_SELLER_MEETING_NOTES=false to disable)
MEETING_NOTES_MAX_CHARS=600
MEETING_NOTES_MAX_TOTAL_CHARS=4000
ENABLE_SELLER_MEETING_NOTES=true

# --- meetings module only, below ---

# Desktop app authenticates its transcript pushes with this shared key.
DESKTOP_API_KEY=

# AWS Bedrock (access key/secret are optional — omit them to use the
# standard AWS credential provider chain)
AWS_BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6

# Summarization limits
SUMMARY_MAX_TOKENS=8192
SUMMARY_MAX_TOKENS_PER_CHUNK=8000
MAX_CONCURRENT_SUMMARIES=1
MAX_TRANSCRIPT_CHARS=1500000
