# Application
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Database (existing wusool_crm database; through the SSM tunnel in dev).
# Either postgresql:// or postgresql+asyncpg:// is accepted; the driver
# scheme is normalized automatically. Shared by both matching-engine and
# ddl-commands — they connect to the same wusool_crm database independently.
DATABASE_URL=postgresql://user:password@localhost:15432/wusool_crm

# Slack — one bot, one app, one token for all 5 commands (/find-match,
# /edit-seller, /edit-buyer, /add-seller, /add-buyer). See SLACK_APP_SETUP.md
# at the repo root.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# SOURCE Attio workspace write access. One workspace serves both
# environments; ATTIO_IS_TEST below is what separates them. /edit-*/add-*
# write to Attio first, then Postgres, in the same request (see
# ddl-commands/README.md).
ATTIO_API_KEY=

# Which half of the shared SOURCE workspace this instance owns. true stamps
# every record it creates is_test=true and makes it ignore production
# records and inbound Attio webhooks entirely; false is the inverse.
# Defaults to true: a prod deploy that forgets it hides new records (loud,
# reversible), a dev deploy that forgets it writes test data into
# production (silent, permanent). In the deployed environments this is
# templated from terraform's var.environment.
ATTIO_IS_TEST=true

# Expected SOURCE workspace id, checked against inbound webhook deliveries.
# Leave unset to skip the check.
ATTIO_WORKSPACE_ID=

# Signs inbound Attio webhook deliveries (POST /webhooks/attio) — returned
# once by Attio in the response to POST /v2/webhooks, never retrievable
# again after that.
ATTIO_WEBHOOK_SECRET=

# --- matching-engine only, below ---

# AWS Bedrock (region/model IDs match what's already provisioned in
# terraform/environments/dev's bedrock-access module; access key/secret are optional —
# omit them to use the standard AWS credential provider chain)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID_EXTRACTION=eu.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_BEDROCK_MODEL_ID_REASONING=eu.anthropic.claude-sonnet-4-6

# Bedrock inference parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TOP_P=0.9

# Matching pipeline
STAGE3_TOP_N=3

# Attio workspace member owning the Qualified deal an approval creates
MATCHING_DEAL_OWNER_ID=

# Scoring configuration (weights should sum to 1.0)
SCORING_WEIGHT_STRATEGY=0.4
SCORING_WEIGHT_SIZE=0.3
SCORING_WEIGHT_SECTOR=0.3

# Confidence multipliers
CONFIDENCE_LLM_EXTRACTED=0.6
CONFIDENCE_LLM_INFERRED=0.4
CONFIDENCE_MISSING_FIELD_PENALTY=0.1
CONFIDENCE_STALE_DATA_PENALTY=0.15

FIRECRAWL_API_KEY=
WEB_FALLBACK_MIN_SCORE=50.0

# Meeting-notes enrichment (buyer side always on; seller side on by default,
# set ENABLE_SELLER_MEETING_NOTES=false to disable)
MEETING_NOTES_MAX_CHARS=600
MEETING_NOTES_MAX_TOTAL_CHARS=4000
ENABLE_SELLER_MEETING_NOTES=true

# --- meetings module only, below ---

# Desktop app authenticates its transcript pushes with this shared key.
DESKTOP_API_KEY=

# AWS Bedrock (access key/secret are optional — omit them to use the
# standard AWS credential provider chain)
AWS_BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6

# Summarization limits
SUMMARY_MAX_TOKENS=8192
SUMMARY_MAX_TOKENS_PER_CHUNK=8000
MAX_CONCURRENT_SUMMARIES=1
MAX_TRANSCRIPT_CHARS=1500000

# In-app feedback delivery (POST /desktop/feedback), sent via SES in the
# background -- the row is always written and the request always returns
# 200 regardless of this config. FEEDBACK_EMAIL_TO is space-separated --
# one or more recipients. Leave either unset to skip scheduling the email
# entirely rather than send from/to the wrong address. FEEDBACK_EMAIL_FROM
# must be a SES-verified identity (wusoolcapital.com is domain-verified as
# of 2026-09-14, so any @wusoolcapital.com address works) -- reverify in
# the SES console before changing it to a different domain, or every send
# fails (logged, not surfaced to the client -- see
# app/models/feedback_submission.py's email_sent column). If the account
# is still in the SES sandbox, every FEEDBACK_EMAIL_TO recipient must also
# be a verified identity.
FEEDBACK_EMAIL_TO=sinanshamsudheen7@gmail.com raoof@azmora.ai
FEEDBACK_EMAIL_FROM=contact@wusoolcapital.com

# --- enrichment only, below ---

# AWS Bedrock / Firecrawl vars (AWS_REGION, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_BEDROCK_MODEL_ID_EXTRACTION, LLM_TEMPERATURE,
# LLM_MAX_TOKENS, FIRECRAWL_API_KEY) are shared with matching-engine above —
# declared once there, read independently here.

# Proposed values below this confidence are dropped before ever reaching
# the operator's confirmation message.
ENRICHMENT_MIN_CONFIDENCE=0.6

# Structured company-data waterfall for seller enrichment (tried in this
# order, before the Firecrawl+LLM fallback). Both optional — omit either to
# skip that tier entirely rather than requiring it to boot. Free tiers:
# Diffbot 10,000 credits/month, People Data Labs 100 lookups/month.
DIFFBOT_API_KEY=
PEOPLE_DATA_LABS_API_KEY=

# --- discovery only, below ---

# Places Text Search + Geocoding — both billed to the same Google Cloud
# project/key. Optional: without it, lead search is disabled rather than
# required to boot.
GOOGLE_PLACES_API_KEY=
DISCOVERY_LEAD_SEARCH_LIMIT=5
# Max discovery searches per buyer role per rolling 24h (in-process, resets on deploy).
DISCOVERY_DAILY_SEARCH_CAP=10
# Parallel Diffbot/PDL lookups while auto-creating discovered sellers.
DISCOVERY_ENRICHMENT_CONCURRENCY=2
# Overall enrichment time budget for one discovery batch, in seconds.
DISCOVERY_ENRICHMENT_BUDGET_S=45

# --- discrepancies only, below ---

# AWS Bedrock vars (AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_BEDROCK_MODEL_ID_EXTRACTION, LLM_TEMPERATURE, LLM_MAX_TOKENS) are
# shared with matching-engine above — declared once there, read
# independently here. No settings of its own: no database, no separate
# context extraction model.

# --- lead_magnets only ---
# DATABASE_URL, AWS_REGION and FIRECRAWL_API_KEY above are shared with the
# other modules; everything specific to the tools is prefixed so it cannot
# collide with them in this one flat file.
LEAD_MAGNET_MODEL_SONNET=eu.anthropic.claude-sonnet-4-6
LEAD_MAGNET_MODEL_HAIKU=eu.anthropic.claude-haiku-4-5-20251001-v1:0
LEAD_MAGNET_FRAME_ANCESTORS=https://wusoolcapital.com https://www.wusoolcapital.com
LEAD_MAGNET_ALLOWED_ORIGINS=
LEAD_MAGNET_RATE_PER_HOUR=20
LEAD_MAGNET_REPORT_READS_PER_HOUR=300
LEAD_MAGNET_REPORT_DOWNLOADS_PER_HOUR=30
LEAD_MAGNET_DEAL_OWNER_ID=
LEAD_MAGNET_DEAL_OWNER_FALLBACK_ID=
LEAD_MAGNET_SWEEPER_INTERVAL_S=300
LEAD_MAGNET_SWEEPER_STALE_AFTER_S=300
LEAD_MAGNET_EMAIL_TO=
LEAD_MAGNET_EMAIL_FROM=
# Gated insights reports (PRD 3). Blank project id disables /reports/*.
LEAD_MAGNET_SANITY_PROJECT_ID=
LEAD_MAGNET_SANITY_DATASET=production
LEAD_MAGNET_WEBFLOW_REPORTS_COLLECTION_ID=6ac64c92647fc1acb46497de
LEAD_MAGNET_WEBFLOW_INSIGHTS_COLLECTION_ID=69aaa645fa60624091050e8e
# Supplied in the Toolkit Secrets Manager env map; never commit the values.
LEAD_MAGNET_SANITY_WEBHOOK_SECRET=
LEAD_MAGNET_SANITY_WRITE_TOKEN=
LEAD_MAGNET_WEBFLOW_API_TOKEN=

# Supplied in the Toolkit Secrets Manager env map; never commit the value.
ARCHITECTURE_BASIC_AUTH_PASSWORD=
