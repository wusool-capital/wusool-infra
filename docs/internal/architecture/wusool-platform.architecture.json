  "cards": [
    {
      "dot": "cyan",
      "title": "One Toolkit process",
      "items": [
        "Serves Slack, the web find-match app, Scribe, the lead tools, and Attio and Sanity webhooks",
        "Renders and gates reports, prints each report PDF once at publish; syncs Webflow cards",
        "Optionally reads Gmail and Calendar metadata into PostgreSQL (the interactions loop, off by default)"
      ]
    },
    {
      "dot": "violet",
      "title": "Data ownership",
      "items": [
        "Attio is the CRM of record and is written first",
        "PostgreSQL mirrors it via webhook and nightly resync",
        "Interaction metadata (headers and subjects, never bodies) is kept 12 months; nothing writes it to Attio yet"
      ]
    },
    {
      "dot": "amber",
      "title": "Operational controls",
      "items": [
        "GitHub OIDC deploys through OpenTofu and SSM",
        "Alarms and GuardDuty findings reach Slack via AWS Chatbot",
        "The nightly resync runs on its own narrow OIDC role; a heartbeat alarm flags a missed run",
        "App secrets are read from Secrets Manager at startup, with no secret files on the instance; devs read only the dev secret",
        "A host watchdog restarts the stack when /health stops answering through Caddy; the app container is memory-capped"
      ]
    }
  ]
}
