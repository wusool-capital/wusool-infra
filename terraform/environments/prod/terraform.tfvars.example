project     = "wusool"
environment = "prod"
aws_region  = "eu-central-1"

key_name         = ""
ssh_cidr_blocks  = []
instance_type    = "t3.small"
ami_architecture = "x86_64"
root_volume_size = 50

# Production traffic should enter through Caddy on HTTPS only.
expose_n8n_port = false
web_cidr_blocks = ["0.0.0.0/0"]
n8n_webhook_url = "https://n8n.wusoolcapital.com/"
n8n_timezone    = "Asia/Dubai"

alert_email = "raoof@azmora.ai"

# Container images, pinned by digest to exactly what prod is running today
# (n8n 2.27.5), so applying changes no versions. Upgrading is now a deliberate
# edit here, reviewed like any other change.
#
# n8nio/runners publishes no stable version tags - only 'latest' and nightlies,
# including a v3 line - so a tag pin could pull a v3 runner against a 2.x n8n.
# Digest is the only safe pin.
n8n_image     = "docker.n8n.io/n8nio/n8n@sha256:d53243d06c7f7de81910ac922ff55ed4b58c9c3c761d7f2f8443d0567990def3"
runners_image = "n8nio/runners@sha256:dd8531c425cd2c60481cafcb145a8c810f628f176bcb8d41f4c75d79272f7d2a"
caddy_image   = "caddy@sha256:af5fdcd76f2db5e4e974ee92f96ee8c0fc3edb55bd4ba5032547cbf3f65e486d"

# Seed prod from a dev snapshot: same schema and data. Set at creation only.
postgres_snapshot_identifier = "wusool-dev-postgres-seed-20260816-0803"
