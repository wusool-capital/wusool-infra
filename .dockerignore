# Build context for workflows/wusool-toolkit/Dockerfile is the REPO ROOT
# (see that Dockerfile's own comment for why: the wusool-db path dependency
# needs the same directory nesting as the real repo). Docker only reads ONE
# .dockerignore, from the context root — this supersedes and folds in what
# used to live in workflows/wusool-toolkit/{matching-engine,ddl-commands}/
# .dockerignore, which no longer take effect for the actual image build.

.git/

# Not needed to build or run the toolkit image.
terraform/
workflows/n8n/
workflows/crm-sync/
workflows/bedrock-ai/
.claude/
.agents/
.github/
scripts/
outputs/

# Python artifacts — the image builds its own venv from scratch; a
# host-built .venv or bytecode must never leak in.
**/__pycache__/
**/*.pyc
**/.venv/
**/.pytest_cache/
**/.ruff_cache/
**/*.egg-info/

# Test suites — not needed at runtime.
workflows/wusool-toolkit/matching-engine/tests/
workflows/wusool-toolkit/ddl-commands/tests/

# Docs — not needed at runtime.
**/*.md

# Local-dev-only files.
.env
.env.*
!.env.example
